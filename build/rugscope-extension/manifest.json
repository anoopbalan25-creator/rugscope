{
  "manifest_version": 3,
  "name": "Rugscope",
  "version": "1.0.0",
  "description": "Auto-scans crypto token pages for rug-pull, liquidity, creator, and market-risk signals.",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.rugcheck.xyz/*",
    "https://api.mainnet-beta.solana.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pump.fun/*",
        "*://*.pump.fun/*",
        "*://dexscreener.com/*",
        "*://*.dexscreener.com/*",
        "*://birdeye.so/*",
        "*://*.birdeye.so/*",
        "*://gmgn.ai/*",
        "*://*.gmgn.ai/*",
        "*://geckoterminal.com/*",
        "*://*.geckoterminal.com/*",
        "*://photon-sol.tinyastro.io/*",
        "*://bullx.io/*",
        "*://*.bullx.io/*",
        "*://defined.fi/*",
        "*://*.defined.fi/*",
        "*://dexview.com/*",
        "*://*.dexview.com/*",
        "*://dextools.io/*",
        "*://*.dextools.io/*",
        "*://ape.pro/*",
        "*://*.ape.pro/*",
        "*://jup.ag/*",
        "*://*.jup.ag/*",
        "*://raydium.io/*",
        "*://*.raydium.io/*",
        "*://solscan.io/*",
        "*://*.solscan.io/*",
        "*://solana.fm/*",
        "*://*.solana.fm/*",
        "*://axiom.trade/*",
        "*://*.axiom.trade/*"
      ],
      "js": [
        "vendor/lightweight-charts.standalone.production.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Rugscope",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon48.png",
        "assets/logo.png",
        "vendor/lightweight-charts.standalone.production.js"
      ],
      "matches": [
        "*://pump.fun/*",
        "*://*.pump.fun/*",
        "*://dexscreener.com/*",
        "*://*.dexscreener.com/*",
        "*://birdeye.so/*",
        "*://*.birdeye.so/*",
        "*://gmgn.ai/*",
        "*://*.gmgn.ai/*",
        "*://geckoterminal.com/*",
        "*://*.geckoterminal.com/*",
        "*://photon-sol.tinyastro.io/*",
        "*://bullx.io/*",
        "*://*.bullx.io/*",
        "*://defined.fi/*",
        "*://*.defined.fi/*",
        "*://dexview.com/*",
        "*://*.dexview.com/*",
        "*://dextools.io/*",
        "*://*.dextools.io/*",
        "*://ape.pro/*",
        "*://*.ape.pro/*",
        "*://jup.ag/*",
        "*://*.jup.ag/*",
        "*://raydium.io/*",
        "*://*.raydium.io/*",
        "*://solscan.io/*",
        "*://*.solscan.io/*",
        "*://solana.fm/*",
        "*://*.solana.fm/*",
        "*://axiom.trade/*",
        "*://*.axiom.trade/*"
      ]
    }
  ]
}

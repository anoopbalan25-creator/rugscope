# RugScope AI - Environment Configuration
# Optional configuration for Colosseum Hackathon & Production Deployment

# Port configuration (default 5173)
PORT=5173
HOST=localhost

# RPC Fast Integration (Optional - if using RPC Fast for accelerated Solana RPC)
# Enter your RPC Fast endpoint and API key here. The backend proxies requests securely
# without exposing credentials to the client browser.
# RPC_FAST_URL=https://solana-mainnet.fast.io
# RPC_FAST_API_KEY=your_rpc_fast_api_key_here

# Alternative Solana RPC URL (Fallback defaults to public mainnet: https://api.mainnet-beta.solana.com)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
